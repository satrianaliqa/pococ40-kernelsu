+static void icnss_schedule_probe_retry(struct icnss_priv *priv)
+{
+	if (!priv->ops || test_bit(ICNSS_DRIVER_PROBED, &priv->state) ||
+	    test_bit(ICNSS_FW_DOWN, &priv->state))
+		return;
+
+	if (priv->probe_retry_cnt >= ICNSS_PROBE_RETRY_MAX) {
+		icnss_pr_err("Exceeded max probe retries (%d)\n",
+			     priv->probe_retry_cnt);
+		return;
+	}
+
+	priv->probe_retry_cnt++;
+	icnss_pr_info("Scheduling driver probe retry %d/%d in %dms\n",
+		      priv->probe_retry_cnt, ICNSS_PROBE_RETRY_MAX,
+		      ICNSS_PROBE_RETRY_MS);
+	schedule_delayed_work(&priv->probe_retry_work,
+			      msecs_to_jiffies(ICNSS_PROBE_RETRY_MS));
